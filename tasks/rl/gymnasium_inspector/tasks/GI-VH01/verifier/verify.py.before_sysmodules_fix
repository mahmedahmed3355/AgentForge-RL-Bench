from __future__ import annotations

import json
import importlib.util
import sys
from pathlib import Path

TASK_ROOT = Path(__file__).resolve().parents[1]
PROJECT_ROOT = TASK_ROOT.parents[5]

# Avoid the collision between this executable file:
#   verifier/verify.py
# and the verifier package:
#   verifier/verifier.py
VERIFIER_IMPL = TASK_ROOT / "verifier" / "verifier.py"

if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

spec = importlib.util.spec_from_file_location(
    "gi_vh01_verifier_impl",
    VERIFIER_IMPL,
)

if spec is None or spec.loader is None:
    raise ImportError(f"Unable to load verifier implementation: {VERIFIER_IMPL}")

module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)

Verifier = module.Verifier


def main() -> int:
    verifier = Verifier()

    trajectory = []

    final_state = {
        "task_id": "GI-VH01",
        "phase": "initial",
        "progress": 0.0,
    }

    result = verifier.verify(
        trajectory=trajectory,
        final_state=final_state,
    )

    payload = {
        "verified": bool(result.passed),
        "score": float(result.score),
        "reasons": list(result.reasons),
    }

    print(json.dumps(payload, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

from __future__ import annotations

import json
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[4]
TASK_ROOT = Path(__file__).resolve().parents[1]

if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from oracle.oracle import Oracle  # type: ignore


def main() -> int:
    oracle = Oracle()

    if hasattr(oracle, "solve"):
        result = oracle.solve()
    elif hasattr(oracle, "run"):
        result = oracle.run()
    elif hasattr(oracle, "execute"):
        result = oracle.execute()
    else:
        raise AttributeError(
            "GI-VH01 Oracle must expose solve(), run(), or execute()."
        )

    if result is None:
        result = {"success": True}

    if hasattr(result, "model_dump"):
        result = result.model_dump()
    elif hasattr(result, "__dict__") and not isinstance(
        result, (str, int, float, bool, list, tuple, dict)
    ):
        result = result.__dict__

    print(json.dumps(result, indent=2, sort_keys=True, default=str))

    output = TASK_ROOT / "oracle_result.json"
    output.write_text(
        json.dumps(result, indent=2, sort_keys=True, default=str) + "\n",
        encoding="utf-8",
    )

    return 0


if __name__ == "__main__":
    raise SystemExit(main())

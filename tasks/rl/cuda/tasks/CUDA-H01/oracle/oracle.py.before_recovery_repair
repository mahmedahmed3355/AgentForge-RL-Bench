from __future__ import annotations

import json
from pathlib import Path
import sys

TASK_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(TASK_ROOT))

from environment.env import CudaH01Environment


def solve(seed: int = 0):
    env = CudaH01Environment(seed=seed)
    observation = env.reset()
    trajectory = []

    def step(tool: str, **args):
        nonlocal observation
        payload = {"tool": tool}
        if args:
            payload["args"] = args
        transition = env.step(payload)
        observation = transition.observation
        trajectory.append({"action": payload, "reward": transition.reward.total})
        return transition

    for tool in (
        "inspect_device", "inspect_pipeline", "inspect_memory",
        "inspect_kernel", "inspect_streams", "inspect_events",
        "inspect_errors",
    ):
        step(tool)

    step("modify_memory_strategy", strategy="pinned")
    step("modify_transfer_strategy", strategy="async")
    step("modify_stream_config", streams=2)
    step("modify_sync_strategy", strategy="device")
    step("benchmark_pipeline")
    step("validate_output")
    step("stress_test")

    step("modify_event_config", events=True)
    step("modify_sync_strategy", strategy="event")

    symptom = observation.get("active_hypothesis", "")
    if symptom == "transform throughput":
        step("modify_kernel_config", blocks=256, shared_kb=0, registers=40)
    elif symptom == "preprocessing latency":
        step("modify_kernel_config", blocks=256, shared_kb=16, registers=32)
    elif symptom == "reduction occupancy":
        step("modify_kernel_config", blocks=256, shared_kb=0, registers=40)
    else:
        step("modify_kernel_config", blocks=256, shared_kb=0, registers=32)

    for stage in (
        "h2d", "preprocess", "transform",
        "reduction", "postprocess", "d2h",
    ):
        step("run_stage", stage=stage)
        step("benchmark_stage", stage=stage)
        step("inspect_errors")
        step("validate_output")
        step("benchmark_stage", stage=stage)
        step("compare_runs")
        step("inspect_pipeline")

    for _ in range(4):
        step("benchmark_pipeline")
        step("compare_runs")
        step("inspect_errors")

    step("benchmark_pipeline")
    step("validate_output")
    step("stress_test")
    step("compare_runs")
    step("benchmark_pipeline")
    step("compare_runs")
    step("final_verify")

    env.close()

    return {
        "success": env.state.success,
        "steps": env.state.step,
        "trajectory": trajectory,
        "final_state": env._observation(),
    }


if __name__ == "__main__":
    seed = int(sys.argv[1]) if len(sys.argv) > 1 else 0
    print(json.dumps(solve(seed), indent=2, sort_keys=True))


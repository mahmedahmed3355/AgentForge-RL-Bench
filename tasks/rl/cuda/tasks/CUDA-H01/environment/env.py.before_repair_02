from __future__ import annotations

from dataclasses import asdict, dataclass, field
from typing import Any
import json
import random

from agentforge.environments.base import BaseEnvironment, EnvironmentStep
from agentforge.core import RewardBreakdown

STAGES = ("h2d", "preprocess", "transform", "reduction", "postprocess", "d2h")

TOOLS = (
    "inspect_device", "inspect_pipeline", "inspect_memory", "inspect_kernel",
    "inspect_streams", "inspect_events", "inspect_errors",
    "run_stage", "run_pipeline", "benchmark_stage", "benchmark_pipeline",
    "validate_output", "stress_test",
    "modify_kernel_config", "modify_memory_strategy", "modify_transfer_strategy",
    "modify_stream_config", "modify_event_config", "modify_sync_strategy",
    "rollback_change", "compare_runs", "final_verify",
)


@dataclass(frozen=True)
class Workload:
    seed: int
    input_mb: int
    tensor_rows: int
    tensor_cols: int
    intensity: int
    memory_pressure: int
    bottleneck: str
    failure_class: str
    delayed_failure: bool
    required_performance: float


def make_workload(seed: int) -> Workload:
    rng = random.Random(seed)
    bottleneck = rng.choice(("transfer", "preprocess", "transform", "reduction"))
    failure = rng.choice(
        ("sync", "stream_order", "missing_event", "kernel",
         "memory", "cross_stage", "intermittent")
    )
    input_mb = rng.choice((32, 64, 128, 256))
    intensity = rng.randint(2, 7)
    pressure = rng.randint(2, 8)
    required = 116.0 + 1.5 * pressure + 0.5 * intensity
    return Workload(
        seed=seed,
        input_mb=input_mb,
        tensor_rows=rng.choice((512, 1024, 2048)),
        tensor_cols=rng.choice((512, 1024, 2048)),
        intensity=intensity,
        memory_pressure=pressure,
        bottleneck=bottleneck,
        failure_class=failure,
        delayed_failure=failure in ("sync", "stream_order", "missing_event"),
        required_performance=required,
    )


@dataclass
class Config:
    memory_strategy: str = "pageable"
    transfer_strategy: str = "sync"
    streams: int = 1
    events: bool = False
    sync_strategy: str = "device"
    blocks: int = 128
    shared_kb: int = 0
    registers: int = 32


@dataclass
class State:
    task_id: str = "CUDA-H01"
    step: int = 0
    mode: str = "simulation"
    stage: str = "input"
    config: Config = field(default_factory=Config)
    workload: dict[str, Any] = field(default_factory=dict)
    health: str = "degraded"
    pipeline_status: str = "blocked"
    benchmark_history: list[dict[str, Any]] = field(default_factory=list)
    validation_history: list[dict[str, Any]] = field(default_factory=list)
    applied_changes: list[dict[str, Any]] = field(default_factory=list)
    rollback_history: list[dict[str, Any]] = field(default_factory=list)
    detected_failures: list[str] = field(default_factory=list)
    recovery_count: int = 0
    replans: int = 0
    active_hypothesis: str | None = None
    terminal: bool = False
    success: bool = False
    last_error: str | None = None
    repeated_actions: dict[str, int] = field(default_factory=dict)
    trajectory: list[dict[str, Any]] = field(default_factory=list)


class CudaH01Environment(BaseEnvironment):
    """Long-horizon CUDA engineering environment with deterministic simulation."""

    def __init__(
        self,
        seed: int = 0,
        max_steps: int = 100,
        real_cuda: bool | None = None,
    ) -> None:
        self.seed = seed
        self.max_steps = max_steps
        self.real_cuda = self._detect_cuda() if real_cuda is None else bool(real_cuda)
        self.workload = make_workload(seed)
        self.state = State(mode="real_cuda" if self.real_cuda else "simulation")

    @staticmethod
    def _detect_cuda() -> bool:
        try:
            import torch
            return bool(torch.cuda.is_available())
        except Exception:
            return False

    def reset(self) -> dict[str, Any]:
        self.workload = make_workload(self.seed)
        self.state = State(mode="real_cuda" if self.real_cuda else "simulation")
        self.state.workload = {
            "input_mb": self.workload.input_mb,
            "tensor_shape": [self.workload.tensor_rows, self.workload.tensor_cols],
            "intensity": self.workload.intensity,
            "memory_pressure": self.workload.memory_pressure,
            "required_performance": self.workload.required_performance,
        }
        return self._observation()

    def _observation(self) -> dict[str, Any]:
        c = self.state.config
        return {
            "task_id": self.state.task_id,
            "step": self.state.step,
            "mode": self.state.mode,
            "stage": self.state.stage,
            "health": self.state.health,
            "pipeline_status": self.state.pipeline_status,
            "config": {
                "memory_strategy": c.memory_strategy,
                "transfer_strategy": c.transfer_strategy,
                "streams": c.streams,
                "events": c.events,
                "sync_strategy": c.sync_strategy,
                "blocks": c.blocks,
                "shared_kb": c.shared_kb,
                "registers": c.registers,
            },
            "workload": dict(self.state.workload),
            "benchmark_count": len(self.state.benchmark_history),
            "validation_count": len(self.state.validation_history),
            "failures": list(self.state.detected_failures),
            "recovery_count": self.state.recovery_count,
            "replans": self.state.replans,
            "active_hypothesis": self.state.active_hypothesis,
            "terminal": self.state.terminal,
            "success": self.state.success,
            "last_error": self.state.last_error,
            "available_tools": list(TOOLS),
        }

    def step(self, action: Any) -> EnvironmentStep:
        if self.state.terminal:
            raise RuntimeError("Cannot step a finished CUDA-H01 episode.")

        self.state.step += 1
        tool, args = self._parse_action(action)
        previous = self._snapshot()
        reward = self._apply(tool, args)
        self._check_timeout()
        observation = self._observation()

        self.state.trajectory.append({
            "step": self.state.step,
            "observation": previous,
            "action": action,
            "reward": asdict(reward),
            "next_observation": observation,
        })

        return EnvironmentStep(
            observation=observation,
            reward=reward,
            done=self.state.terminal,
            info={
                "task_id": "CUDA-H01",
                "tool": tool,
                "mode": self.state.mode,
                "step": self.state.step,
            },
        )

    def _parse_action(self, action: Any) -> tuple[str, dict[str, Any]]:
        if isinstance(action, str):
            return action, {}
        if isinstance(action, dict):
            tool = str(action.get("tool", ""))
            args = action.get("args", {})
            return tool, args if isinstance(args, dict) else {}
        raise ValueError("action must be a tool string or {'tool': ..., 'args': {...}}")

    def _apply(self, tool: str, args: dict[str, Any]) -> RewardBreakdown:
        penalty = 0.0

        if tool not in TOOLS:
            return RewardBreakdown(penalties=-1.0)

        self.state.repeated_actions[tool] = self.state.repeated_actions.get(tool, 0) + 1
        if self.state.repeated_actions[tool] > 2 and tool.startswith("inspect_"):
            penalty -= 0.1

        if tool == "inspect_device":
            return RewardBreakdown(progress=0.02, efficiency=0.05, penalties=penalty)
        if tool == "inspect_pipeline":
            self.state.active_hypothesis = self._pipeline_symptom()
            return RewardBreakdown(progress=0.08, efficiency=0.04, penalties=penalty)
        if tool == "inspect_memory":
            return RewardBreakdown(progress=0.06, efficiency=0.04, penalties=penalty)
        if tool == "inspect_kernel":
            return RewardBreakdown(progress=0.06, efficiency=0.04, penalties=penalty)
        if tool == "inspect_streams":
            return RewardBreakdown(progress=0.06, efficiency=0.04, penalties=penalty)
        if tool == "inspect_events":
            return RewardBreakdown(progress=0.06, efficiency=0.04, penalties=penalty)
        if tool == "inspect_errors":
            self.state.active_hypothesis = self._error_symptom()
            return RewardBreakdown(
                progress=0.10, correctness=0.05, efficiency=0.04, penalties=penalty
            )

        if tool == "modify_memory_strategy":
            return self._modify("memory_strategy", str(args.get("strategy", "")), penalty)
        if tool == "modify_transfer_strategy":
            return self._modify("transfer_strategy", str(args.get("strategy", "")), penalty)
        if tool == "modify_stream_config":
            return self._modify("streams", int(args.get("streams", 1)), penalty)
        if tool == "modify_event_config":
            return self._modify("events", bool(args.get("events", False)), penalty)
        if tool == "modify_sync_strategy":
            return self._modify("sync_strategy", str(args.get("strategy", "")), penalty)
        if tool == "modify_kernel_config":
            return self._modify_kernel(args, penalty)
        if tool == "rollback_change":
            return self._rollback(penalty)

        if tool == "run_stage":
            return self._run_stage(str(args.get("stage", self._next_stage())), penalty)
        if tool == "run_pipeline":
            return self._run_pipeline(penalty)
        if tool == "benchmark_stage":
            return self._benchmark(str(args.get("stage", self._current_stage())), penalty)
        if tool == "benchmark_pipeline":
            return self._benchmark("pipeline", penalty)
        if tool == "validate_output":
            return self._validate(penalty)
        if tool == "stress_test":
            return self._stress(penalty)
        if tool == "compare_runs":
            return self._compare(penalty)
        if tool == "final_verify":
            self.finalize()
            if self.state.success:
                return RewardBreakdown(
                    correctness=0.7, tests=0.5, efficiency=0.3,
                    terminal=5.0, penalties=penalty
                )
            if self.state.step < self.max_steps:
                self.state.terminal = False
            return RewardBreakdown(
                correctness=-0.6, terminal=-1.0, penalties=-0.2
            )

        return RewardBreakdown(penalties=-0.5)

    def _modify(self, key: str, value: Any, penalty: float) -> RewardBreakdown:
        if key == "memory_strategy" and value not in ("pageable", "pinned"):
            return RewardBreakdown(penalties=-0.8)
        if key == "transfer_strategy" and value not in ("sync", "async"):
            return RewardBreakdown(penalties=-0.8)
        if key == "streams" and value not in (1, 2, 3):
            return RewardBreakdown(penalties=-0.8)
        if key == "sync_strategy" and value not in ("device", "event"):
            return RewardBreakdown(penalties=-0.8)

        old = getattr(self.state.config, key)
        setattr(self.state.config, key, value)
        self.state.applied_changes.append({
            "key": key, "old": old, "new": value, "step": self.state.step
        })

        correct = self._change_is_plausible(key, value)
        return RewardBreakdown(
            progress=0.15,
            correctness=0.25 if correct else -0.20,
            efficiency=-0.03,
            penalties=penalty,
        )

    def _modify_kernel(self, args: dict[str, Any], penalty: float) -> RewardBreakdown:
        c = self.state.config
        old = {
            "blocks": c.blocks,
            "shared_kb": c.shared_kb,
            "registers": c.registers,
        }

        for key in old:
            if key in args:
                setattr(c, key, int(args[key]))

        if c.blocks not in (64, 128, 256, 512):
            return RewardBreakdown(penalties=-0.8)
        if c.shared_kb not in (0, 16, 32, 48):
            return RewardBreakdown(penalties=-0.8)
        if c.registers not in (24, 32, 40, 48, 64):
            return RewardBreakdown(penalties=-0.8)

        self.state.applied_changes.append({
            "key": "kernel", "old": old,
            "new": {
                "blocks": c.blocks,
                "shared_kb": c.shared_kb,
                "registers": c.registers,
            },
            "step": self.state.step,
        })

        return RewardBreakdown(
            progress=0.15,
            correctness=0.25 if self._kernel_is_plausible() else -0.25,
            efficiency=-0.03,
            penalties=penalty,
        )

    def _change_is_plausible(self, key: str, value: Any) -> bool:
        if key == "memory_strategy":
            return self.workload.bottleneck == "transfer" or self.workload.memory_pressure >= 6
        if key == "transfer_strategy":
            return value == "async"
        if key == "streams":
            return self.workload.bottleneck in ("transfer", "preprocess")
        if key == "events":
            return bool(value)
        if key == "sync_strategy":
            return value == "event" and self.state.config.transfer_strategy == "async"
        return True

    def _kernel_is_plausible(self) -> bool:
        c = self.state.config
        if self.workload.bottleneck == "transform":
            return c.blocks in (256, 512) and c.registers <= 48
        if self.workload.bottleneck == "preprocess":
            return c.shared_kb >= 16 and c.blocks in (128, 256)
        if self.workload.bottleneck == "reduction":
            return c.blocks in (256, 512) and c.registers in (32, 40)
        return c.blocks in (128, 256)

    def _next_stage(self) -> str:
        order = list(STAGES)
        if self.state.stage == "input":
            return order[0]
        try:
            idx = order.index(self.state.stage)
            return order[min(idx + 1, len(order) - 1)]
        except ValueError:
            return order[0]

    def _current_stage(self) -> str:
        return STAGES[0] if self.state.stage == "input" else self.state.stage

    def _run_stage(self, stage: str, penalty: float) -> RewardBreakdown:
        if stage not in STAGES:
            return RewardBreakdown(penalties=-0.8)

        expected = self._next_stage()
        if stage != expected:
            self.state.last_error = f"stage_order_violation:{stage}:expected:{expected}"
            if "cross_stage" not in self.state.detected_failures:
                self.state.detected_failures.append("cross_stage")
            return RewardBreakdown(penalties=-0.6, correctness=-0.3)

        failure = self._execution_failure(stage)
        if failure:
            self.state.health = "failed"
            self.state.last_error = failure
            if failure not in self.state.detected_failures:
                self.state.detected_failures.append(failure)
            return RewardBreakdown(
                correctness=-0.5, progress=0.05, penalties=-0.3
            )

        self.state.stage = stage
        self.state.pipeline_status = "running"
        self.state.health = "healthy"
        self.state.last_error = None
        return RewardBreakdown(
            progress=0.45, correctness=0.35, efficiency=0.05, penalties=penalty
        )

    def _run_pipeline(self, penalty: float) -> RewardBreakdown:
        values = {"progress": 0.0, "correctness": 0.0, "tests": 0.0,
                  "efficiency": 0.0, "terminal": 0.0, "penalties": 0.0}
        for _ in STAGES:
            reward = self._run_stage(self._next_stage(), penalty)
            for key in values:
                values[key] += getattr(reward, key)
            if reward.correctness < 0:
                break
        return RewardBreakdown(**values)

    def _execution_failure(self, stage: str) -> str | None:
        c = self.state.config
        if c.transfer_strategy == "async" and c.streams > 1 and not c.events:
            if stage in ("preprocess", "transform"):
                return "missing_event_dependency"
        if (
            c.transfer_strategy == "async"
            and c.streams > 1
            and c.sync_strategy == "device"
            and stage == "preprocess"
        ):
            return "stream_order_violation"
        if c.blocks == 512 and c.registers >= 64:
            return "incorrect_kernel_configuration"
        if (
            c.memory_strategy == "pageable"
            and self.workload.memory_pressure >= 7
            and stage == "h2d"
        ):
            return "memory_transfer_inefficiency"
        if c.streams == 3 and self.workload.memory_pressure >= 8 and stage == "reduction":
            return "resource_pressure"
        if (
            self.workload.failure_class == "kernel"
            and stage == "transform"
            and not self._kernel_is_plausible()
        ):
            return "incorrect_kernel_configuration"
        return None

    def _benchmark(self, scope: str, penalty: float) -> RewardBreakdown:
        score = self._performance_score()
        probe = self._real_cuda_probe(scope)
        entry = {
            "step": self.state.step,
            "scope": scope,
            "score": score,
            "config": asdict(self.state.config),
            "real_cuda_probe": probe,
        }
        self.state.benchmark_history.append(entry)
        improved = (
            len(self.state.benchmark_history) == 1
            or score > self.state.benchmark_history[-2]["score"]
        )
        return RewardBreakdown(
            progress=0.12,
            efficiency=0.18 if improved else 0.03,
            correctness=0.08 if score >= self.workload.required_performance else 0.0,
            penalties=penalty,
        )

    def _real_cuda_probe(self, scope: str) -> dict[str, Any]:
        if not self.real_cuda:
            return {"available": False, "scope": scope}
        try:
            import time
            import torch

            n = max(
                1024,
                min(self.workload.tensor_rows * self.workload.tensor_cols, 1 << 20),
            )
            host = torch.randn(
                n, dtype=torch.float32,
                pin_memory=self.state.config.memory_strategy == "pinned",
            )
            start = time.perf_counter()

            if (
                self.state.config.transfer_strategy == "async"
                and self.state.config.streams > 1
            ):
                streams = [torch.cuda.Stream() for _ in range(self.state.config.streams)]
                event = torch.cuda.Event(enable_timing=True)
                dev = torch.empty_like(host, device="cuda")

                with torch.cuda.stream(streams[0]):
                    dev.copy_(host, non_blocking=True)
                    dev.mul_(1.001)
                    event.record(streams[0])

                streams[1].wait_event(event)
                with torch.cuda.stream(streams[1]):
                    dev.add_(0.001)

                torch.cuda.synchronize()
            else:
                dev = host.to("cuda")
                dev.mul_(1.001).add_(0.001)
                torch.cuda.synchronize()

            elapsed_ms = (time.perf_counter() - start) * 1000.0
            return {
                "available": True,
                "scope": scope,
                "elapsed_ms": elapsed_ms,
            }
        except Exception as exc:
            return {
                "available": True,
                "scope": scope,
                "error": type(exc).__name__,
            }

    def _performance_score(self) -> float:
        c = self.state.config
        score = 92.0
        if c.memory_strategy == "pinned":
            score += 12
        if c.transfer_strategy == "async":
            score += 10
        if c.streams == 2:
            score += 8
        elif c.streams == 3:
            score += 5
        if c.events:
            score += 5
        if c.sync_strategy == "event":
            score += 2
        if self._kernel_is_plausible():
            score += 12
        if self.workload.bottleneck == "transfer" and c.memory_strategy == "pinned":
            score += 5
        if (
            c.transfer_strategy == "async"
            and c.streams > 1
            and not c.events
        ):
            score -= 20
        if (
            c.transfer_strategy == "async"
            and c.streams > 1
            and c.sync_strategy == "device"
        ):
            score -= 15
        if c.memory_strategy == "pageable" and self.workload.memory_pressure >= 6:
            score -= 8
        if c.registers >= 64:
            score -= 10
        return score

    def _validate(self, penalty: float) -> RewardBreakdown:
        immediate = self._correctness()
        delayed = bool(
            self.state.detected_failures
            and self.state.detected_failures[-1]
            in ("missing_event_dependency", "stream_order_violation")
        )
        passed = immediate and not delayed

        self.state.validation_history.append({
            "step": self.state.step,
            "passed": passed,
            "immediate_correct": immediate,
            "performance": self._performance_score(),
        })

        if passed:
            # A successful validation establishes the currently applied
            # configuration as healthy.  This is intentionally separate
            # from delayed-failure discovery: unsafe async configurations
            # may remain locally healthy until stress testing exposes the
            # synchronization defect.
            self.state.health = "healthy"
            self.state.last_error = None
            return RewardBreakdown(
                correctness=0.5, tests=0.4, progress=0.18, penalties=penalty
            )

        self.state.health = "failed"
        self.state.last_error = self.state.last_error or "validation_failed"
        return RewardBreakdown(
            correctness=-0.5, tests=-0.2, penalties=-0.2
        )

    def _stress(self, penalty: float) -> RewardBreakdown:
        if (
            self.state.config.transfer_strategy == "async"
            and self.state.config.streams > 1
            and not self.state.config.events
        ):
            self.state.health = "failed"
            self.state.last_error = "delayed_synchronization_failure"
            if "delayed_synchronization_failure" not in self.state.detected_failures:
                self.state.detected_failures.append("delayed_synchronization_failure")
            self.state.benchmark_history.append({
                "step": self.state.step,
                "scope": "stress",
                "score": self._performance_score(),
                "config": asdict(self.state.config),
            })
            return RewardBreakdown(
                correctness=-0.45, progress=0.2, tests=0.25, penalties=-0.15
            )

        self.state.benchmark_history.append({
            "step": self.state.step,
            "scope": "stress",
            "score": self._performance_score(),
            "config": asdict(self.state.config),
        })
        return RewardBreakdown(
            progress=0.15, tests=0.35, efficiency=0.12, penalties=penalty
        )

    def _compare(self, penalty: float) -> RewardBreakdown:
        if len(self.state.benchmark_history) < 2:
            return RewardBreakdown(penalties=-0.2)
        previous, current = self.state.benchmark_history[-2:]
        delta = current["score"] - previous["score"]
        return RewardBreakdown(
            progress=0.08,
            efficiency=0.15 if delta > 0 else 0.02,
            penalties=penalty,
        )

    def _rollback(self, penalty: float) -> RewardBreakdown:
        if not self.state.applied_changes:
            return RewardBreakdown(penalties=-0.4)

        last = self.state.applied_changes.pop()
        if last["key"] == "kernel":
            for key, value in last["old"].items():
                setattr(self.state.config, key, value)
        else:
            setattr(self.state.config, last["key"], last["old"])

        self.state.rollback_history.append(last)
        self.state.recovery_count += 1
        self.state.replans += 1
        self.state.health = "degraded"
        self.state.last_error = None

        return RewardBreakdown(
            progress=0.35, correctness=0.35, tests=0.15,
            efficiency=0.08, penalties=penalty
        )

    def _correctness(self) -> bool:
        c = self.state.config

        # The asynchronous multi-stream dependency is intentionally
        # delayed.  An unsafe configuration may look locally correct
        # until stress execution exposes the synchronization failure.
        #
        # Therefore an unsafe async configuration is not immediately
        # rejected by validate_output when no failure has been observed.
        # Once the delayed failure is observed, correctness remains false
        # until the configuration is repaired.
        if (
            c.transfer_strategy == "async"
            and c.streams > 1
            and (not c.events or c.sync_strategy != "event")
        ):
            if self.state.detected_failures:
                return False

        if c.registers >= 64 or c.shared_kb > 48:
            return False

        if self.state.health == "failed":
            return False

        return True

    def _pipeline_symptom(self) -> str:
        return {
            "transfer": "transfer saturation",
            "preprocess": "preprocessing latency",
            "transform": "transform throughput",
            "reduction": "reduction occupancy",
        }[self.workload.bottleneck]

    def _error_symptom(self) -> str:
        return {
            "sync": "late-stage ordering inconsistency",
            "stream_order": "cross-stream completion mismatch",
            "missing_event": "asynchronous dependency not observed",
            "kernel": "transform correctness/performance instability",
            "memory": "host/device transfer degradation",
            "cross_stage": "stage dependency violation",
            "intermittent": "intermittent execution anomaly",
        }[self.workload.failure_class]

    def finalize(self) -> None:
        valid = bool(
            self.state.validation_history
            and self.state.validation_history[-1]["passed"]
        )
        performance = self._performance_score() >= self.workload.required_performance
        stress = any(
            item.get("scope") == "stress"
            for item in self.state.benchmark_history
        )
        recovered = self.state.recovery_count >= 1 if self.workload.delayed_failure else True

        self.state.success = bool(
            valid
            and performance
            and stress
            and recovered
            and self.state.stage == "d2h"
        )
        self.state.terminal = True

    def _check_timeout(self) -> None:
        if self.state.step >= self.max_steps and not self.state.terminal:
            self.state.terminal = True
            self.state.success = False
            self.state.last_error = "timeout"

    def _snapshot(self) -> dict[str, Any]:
        return json.loads(json.dumps(self._observation(), default=str))

    def close(self) -> None:
        self.state.terminal = True

